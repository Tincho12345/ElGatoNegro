@model List<TrabajosWeb.Shared.DTOs.SubcategoriaDto>
@{
    ViewData["Title"] = "Subcategorías";
    Layout = "_LayoutSalone";
}

<div class="container-fluid py-5">
    <div class="container">
        <!-- Cabecera del Panel -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
            <div>
                <h1 class="font-dancing-script text-primary mb-1">Administración</h1>
                <h2 class="mb-0">Subcategorías de productos</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver al panel
                </a>
                <a asp-action="NuevaSubcategoria" class="btn btn-primary btn-sm px-4">
                    <i class="fa-solid fa-plus me-1"></i> Nueva subcategoría
                </a>
            </div>
        </div>

        <!-- Contenido Principal: Tabla o Estado Vacío -->
        @if (!Model.Any())
        {
            <div class="text-center bg-light p-5 border rounded shadow-sm">
                <i class="fa-solid fa-layer-group fa-4x text-primary mb-3"></i>
                <h4 class="mb-3">No hay subcategorías cargadas.</h4>
                <p class="text-muted mb-4">
                    Sirven para que la clienta filtre dentro de Productos: cremas, shampoo, tinturas.
                </p>
                <a asp-action="NuevaSubcategoria" class="btn btn-primary px-4">Crear la primera</a>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 80px;">Orden</th>
                                    <th scope="col">Nombre</th>
                                    <th scope="col">Productos</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="text-end" style="width: 120px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subcategoria in Model)
                                {
                                    <tr>
                                        <td class="text-muted">@subcategoria.Orden</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrWhiteSpace(subcategoria.Icono))
                                                {
                                                    <i class="@subcategoria.Icono text-primary me-2"></i>
                                                }
                                                <div>
                                                    <div class="fw-bold">@subcategoria.Nombre</div>
                                                    @if (!string.IsNullOrWhiteSpace(subcategoria.Descripcion))
                                                    {
                                                        <small class="text-muted">@subcategoria.Descripcion</small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted">@subcategoria.CantidadProductos</td>
                                        <td>
                                            @if (subcategoria.Activa)
                                            {
                                                <span class="badge bg-success">Activa</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Oculta</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-action="EditarSubcategoria" asp-route-id="@subcategoria.Id"
                                                   class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form asp-action="EliminarSubcategoria" method="post" class="d-inline"
                                                      data-confirmar="¿Eliminar esta subcategoría?">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@subcategoria.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                        <i class="fa-regular fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <p class="text-muted small mt-3">
                Una subcategoría con productos no se puede eliminar. Si querés sacarla del filtro sin perder el
                contenido, editala y desmarcá «Activa».
            </p>
        }
    </div>
</div>

@section Estilos {
    <style>
        html[data-tema="oscuro"] .card,
        html[data-tema="oscuro"] .bg-light {
            background-color: #1a1a1a !important;
            color: #e0e0e0 !important;
            border-color: #333 !important;
        }

        html[data-tema="oscuro"] .table {
            color: #e0e0e0 !important;
        }

        html[data-tema="oscuro"] .table-light {
            background-color: #222 !important;
            color: #fff !important;
        }
    </style>
}
