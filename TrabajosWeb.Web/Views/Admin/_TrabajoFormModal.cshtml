@using TrabajosWeb.Shared.DTOs
@model TrabajosWeb.Web.Models.TrabajoFormViewModel
@{
    // Este partial es el contenido del modal. La cabecera y los botones de
    // acción los pone trabajo-modal.js alrededor.
}

<form id="formTrabajo" asp-action="GuardarTrabajo" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="resumen-errores"></div>

    <div class="campo">
        <label asp-for="Trabajo.Titulo">Título</label>
        <input asp-for="Trabajo.Titulo" class="entrada"
               placeholder="Balayage en tonos miel" autofocus />
        <span asp-validation-for="Trabajo.Titulo"></span>
    </div>

    <div class="campo">
        <label asp-for="Trabajo.Descripcion">
            Descripción <span class="ayuda">(opcional)</span>
        </label>
        <textarea asp-for="Trabajo.Descripcion" class="entrada" rows="4"
                  placeholder="Contá qué se hizo, qué productos se usaron, cuánto llevó."></textarea>
        <span asp-validation-for="Trabajo.Descripcion"></span>
    </div>

    <div class="campo">
        <label asp-for="Trabajo.CategoriaId">Categoría</label>
        <select asp-for="Trabajo.CategoriaId" asp-items="Model.Categorias" class="entrada"
                data-productos="@Model.CategoriaProductosId"
                onchange="var b=document.getElementById('bloqueProductos'); if(b) b.hidden = (this.value !== this.dataset.productos);">
            <option value="">Elegí una categoría</option>
        </select>
        <span asp-validation-for="Trabajo.CategoriaId"></span>
    </div>

    @if (Model.CategoriaProductosId.HasValue)
    {
        @* Solo los productos llevan subcategoría y marca. El bloque arranca oculto
           salvo que el trabajo ya sea de esa categoría. *@
        var esProducto = Model.Trabajo.CategoriaId == Model.CategoriaProductosId.Value;

        <div id="bloqueProductos" hidden="@(esProducto ? null : "hidden")">
            <div class="grilla-precios">
                <div class="campo">
                    <label asp-for="Trabajo.SubcategoriaId">
                        Subcategoría <span class="ayuda">(opcional)</span>
                    </label>
                    <select asp-for="Trabajo.SubcategoriaId" asp-items="Model.Subcategorias" class="entrada">
                        <option value="">Sin subcategoría</option>
                    </select>
                    <span class="ayuda chico">Cremas, shampoo, tinturas.</span>
                    <span asp-validation-for="Trabajo.SubcategoriaId"></span>
                </div>

                <div class="campo">
                    <label asp-for="Trabajo.MarcaId">
                        Marca <span class="ayuda">(opcional)</span>
                    </label>
                    <select asp-for="Trabajo.MarcaId" asp-items="Model.Marcas" class="entrada">
                        <option value="">Sin marca</option>
                    </select>
                    <span asp-validation-for="Trabajo.MarcaId"></span>
                </div>
            </div>
        </div>
    }

    <div class="opciones-linea">
        <div class="opcion">
            <input asp-for="Trabajo.Publicado" type="checkbox" />
            <label asp-for="Trabajo.Publicado">Publicado</label>
        </div>

        <div class="opcion">
            <input asp-for="Trabajo.Destacado" type="checkbox" />
            <label asp-for="Trabajo.Destacado">Destacado</label>
        </div>
    </div>

    <hr class="separador-modal" />

    <h3 class="titulo-bloque">Precio y oferta</h3>
    <p class="ayuda chico" style="margin-bottom:18px;">
        Todo esto es opcional. Lo que dejes vacío no se muestra en la web.
    </p>

    <div class="grilla-precios">
        <div class="campo">
            <label asp-for="Trabajo.Precio">Precio</label>
            <input asp-for="Trabajo.Precio" class="entrada" type="number" step="0.01" min="0"
                   placeholder="239999" />
            <span class="ayuda chico">Sin puntos ni símbolo.</span>
            <span asp-validation-for="Trabajo.Precio"></span>
        </div>

        <div class="campo">
            <label asp-for="Trabajo.PrecioAnterior">Precio anterior</label>
            <input asp-for="Trabajo.PrecioAnterior" class="entrada" type="number" step="0.01" min="0"
                   placeholder="372252" />
            <span class="ayuda chico">Tiene que ser mayor que el actual.</span>
            <span asp-validation-for="Trabajo.PrecioAnterior"></span>
        </div>
    </div>

    <div class="grilla-precios">
        <div class="campo">
            <label asp-for="Trabajo.EtiquetaOferta">Etiqueta</label>
            <input asp-for="Trabajo.EtiquetaOferta" class="entrada" placeholder="2x1" />
            <span class="ayuda chico">Vacía y con dos precios: el porcentaje sale solo.</span>
            <span asp-validation-for="Trabajo.EtiquetaOferta"></span>
        </div>

        <div class="campo">
            <label asp-for="Trabajo.TextoOferta">Texto de la oferta</label>
            <input asp-for="Trabajo.TextoOferta" class="entrada"
                   placeholder="Pague dos y lleve tres" />
            <span asp-validation-for="Trabajo.TextoOferta"></span>
        </div>
    </div>

    <hr class="separador-modal" />

    <h3 class="titulo-bloque">Fotos y videos</h3>

    <div class="campo">
        <label for="archivos" class="zona-archivos" id="zonaArchivos">
            <i class="fa-solid fa-cloud-arrow-up"></i>
            <span class="zona-titulo">Elegí las fotos y videos</span>
            <span class="ayuda chico">
                JPG, PNG, WEBP, MP4, WEBM o MOV. Hasta 200 MB por archivo.
            </span>
        </label>
        <input type="file" name="archivos" id="archivos" hidden
               multiple accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,video/quicktime" />
    </div>

    @* Las miniaturas de lo que se va a subir las arma trabajo-modal.js *@
    <div class="previas" id="previas"></div>

    @if (!Model.EsNuevo && Model.MediosActuales.Any())
    {
        <h3 class="titulo-bloque" style="margin-top:24px;">Ya cargados</h3>

        <div class="medios" data-vacio="Ya no quedan archivos cargados.">
            @foreach (var media in Model.MediosActuales)
            {
                var url = Model.ApiBaseUrl + media.Url;

                <div class="medio">
                    @if (media.Tipo == TipoMedia.Imagen)
                    {
                        <img src="@url" alt="@media.TextoAlternativo" loading="lazy" />
                    }
                    else
                    {
                        <video src="@url" preload="metadata" muted></video>
                    }

                    <form asp-action="EliminarMedia" method="post"
                          data-confirmar="¿Eliminar este archivo?"
                          data-ajax data-quitar=".medio"
                          data-exito="Archivo eliminado.">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="trabajoId" value="@Model.Id" />
                        <input type="hidden" name="mediaId" value="@media.Id" />
                        <button type="submit" class="quitar" title="Eliminar">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    }
</form>
