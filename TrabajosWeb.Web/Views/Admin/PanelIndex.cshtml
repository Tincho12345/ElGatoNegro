@using TrabajosWeb.Shared.DTOs
@model TrabajosWeb.Web.Models.PanelViewModel
@{
    ViewData["Title"] = "Panel de Administración";
    Layout = "_LayoutSalone";
}

<div class="container-fluid py-5">
    <div class="container">
        <!-- Cabecera del Panel -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 gap-3">
            <div>
                <h1 class="font-dancing-script text-primary mb-1">Gestión</h1>
                <h2 class="mb-0">Panel de Control</h2>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Categorias" class="btn btn-outline-primary btn-sm px-3">
                    <i class="fa-solid fa-tags me-1"></i> Categorías
                </a>
                <a asp-action="Subcategorias" class="btn btn-outline-primary btn-sm px-3">
                    <i class="fa-solid fa-layer-group me-1"></i> Subcategorías
                </a>
                <a asp-action="Marcas" class="btn btn-outline-primary btn-sm px-3">
                    <i class="fa-solid fa-award me-1"></i> Marcas
                </a>
                <a asp-action="Consultas" class="btn btn-outline-primary btn-sm px-3 position-relative">
                    <i class="fa-regular fa-envelope me-1"></i> Consultas
                    @if (Model.ConsultasSinLeer > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @Model.ConsultasSinLeer
                        </span>
                    }
                </a>
                <a asp-action="Ajustes" class="btn btn-outline-primary btn-sm px-3">
                    <i class="fa-solid fa-gear me-1"></i> Datos del sitio
                </a>
                <a href="~/docs/Manual-El-Gato-Negro.pdf" target="_blank" rel="noopener"
                   class="btn btn-outline-secondary btn-sm px-3" data-sin-transicion>
                    <i class="fa-regular fa-file-pdf me-1"></i> Manual
                </a>
                <a asp-action="NuevoTrabajo" class="btn btn-primary btn-sm px-4">
                    <i class="fa-solid fa-plus me-1"></i> Nueva Publicación
                </a>
            </div>
        </div>

        <!-- Tarjetas de Resumen / Estadísticas -->
        <div class="row g-4 mb-5" id="panelResumen">
            <div class="col-sm-6 col-xl-3">
                <div class="bg-light p-4 border rounded-4 shadow-sm text-center">
                    <h3 class="display-5 text-primary mb-2" data-contador="total">@Model.Trabajos.Count</h3>
                    <span class="text-muted text-uppercase fs-6 fw-bold">Trabajos cargados</span>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="bg-light p-4 border rounded-4 shadow-sm text-center">
                    <h3 class="display-5 text-success mb-2" data-contador="publicados">@Model.Trabajos.Count(t => t.Publicado)</h3>
                    <span class="text-muted text-uppercase fs-6 fw-bold">Visibles en la web</span>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="bg-light p-4 border rounded-4 shadow-sm text-center">
                    <h3 class="display-5 text-info mb-2">@Model.Categorias.Count(c => c.Activa)</h3>
                    <span class="text-muted text-uppercase fs-6 fw-bold">Categorías activas</span>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="bg-light p-4 border rounded-4 shadow-sm text-center @(Model.ConsultasSinLeer > 0 ? "border-danger" : "")">
                    <h3 class="display-5 @(Model.ConsultasSinLeer > 0 ? "text-danger" : "text-secondary") mb-2">@Model.ConsultasSinLeer</h3>
                    <span class="text-muted text-uppercase fs-6 fw-bold">Consultas sin leer</span>
                </div>
            </div>
        </div>

        <!-- Contenido Principal: Tabla o Estado Vacío -->
        <div id="panelContenido">
        @if (!Model.Trabajos.Any())
        {
            <div class="text-center bg-light p-5 border rounded shadow-sm">
                <i class="fa-regular fa-images fa-4x text-primary mb-3"></i>
                <h4 class="mb-3">Todavía no cargaste ningún trabajo.</h4>
                <p class="text-muted mb-4">Comenzá a poblar tu catálogo o configurá los datos generales del salón.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-action="Ajustes" class="btn btn-outline-primary px-4">
                        <i class="fa-solid fa-gear me-1"></i> Datos del sitio
                    </a>
                    <a href="~/docs/Manual-El-Gato-Negro.pdf" target="_blank" rel="noopener"
                       class="btn btn-outline-secondary px-4" data-sin-transicion>
                        <i class="fa-regular fa-file-pdf me-1"></i> Manual
                    </a>
                    <a asp-action="NuevoTrabajo" class="btn btn-primary px-4">Cargar el primero</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" style="width: 80px;"></th>
                                    <th scope="col">Título</th>
                                    <th scope="col">Categoría</th>
                                    <th scope="col">Archivos</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col">Actualizado</th>
                                    <th scope="col" class="text-end" style="width: 120px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody data-vacio="Ya no quedan trabajos cargados.">
                                @foreach (var trabajo in Model.Trabajos)
                                {
                                    var portada = trabajo.Medios
                                        .OrderBy(m => m.Orden)
                                        .FirstOrDefault(m => m.Tipo == TipoMedia.Imagen);

                                    <tr>
                                        <td>
                                            @if (portada is not null)
                                            {
                                                <img src="@(Model.ApiBaseUrl + portada.Url)" alt=""
                                                     class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="bg-secondary rounded d-flex align-items-center justify-content-center text-white" style="width: 50px; height: 50px;">
                                                    <i class="fa-solid fa-image"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-bold">@trabajo.Titulo</div>
                                            @if (trabajo.Destacado)
                                            {
                                                <span class="badge bg-warning text-dark mt-1">Destacado</span>
                                            }
                                        </td>
                                        <td class="text-muted">@trabajo.CategoriaNombre</td>
                                        <td class="text-muted small">
                                            @trabajo.Medios.Count(m => m.Tipo == TipoMedia.Imagen) fotos ·
                                            @trabajo.Medios.Count(m => m.Tipo == TipoMedia.Video) videos
                                        </td>
                                        <td>
                                            @if (trabajo.Publicado)
                                            {
                                                <span class="badge bg-success">Publicado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Borrador</span>
                                            }
                                        </td>
                                        <td class="text-muted small">
                                            @((trabajo.ModifiedDate ?? trabajo.CreatedDate).ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-2">
                                                <a asp-action="EditarTrabajo" asp-route-id="@trabajo.Id"
                                                   class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="fa-solid fa-pen"></i>
                                                </a>
                                                <form asp-action="EliminarTrabajo" method="post" class="d-inline"
                                                      data-confirmar="Se elimina el trabajo y todas sus fotos y videos. ¿Continuar?"
                                                      data-ajax data-quitar="tr"
                                                      data-exito="Trabajo eliminado.">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@trabajo.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                        <i class="fa-regular fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        </div>
    </div>
</div>

@section Estilos {
    <style>
        /* Ajustes específicos si se requieren para el panel en modo oscuro */
        html[data-tema="oscuro"] .card,
        html[data-tema="oscuro"] .bg-light {
            background-color: #1a1a1a !important;
            color: #e0e0e0 !important;
            border-color: #333 !important;
        }

        html[data-tema="oscuro"] .table {
            color: #e0e0e0 !important;
        }

        html[data-tema="oscuro"] .table-light {
            background-color: #222 !important;
            color: #fff !important;
        }
    </style>
}