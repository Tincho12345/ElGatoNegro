@using TrabajosWeb.Web.Services
@inject IAjustesService AjustesSrv
@{
    var sitio = await AjustesSrv.ObtenerAsync();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @sitio.NombreSitio</title>
    <meta name="description" content="@(sitio.TextoBienvenida ?? "Peluquería. Cortes, color, brushing y tratamientos.")" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" href="~/img/gato-negro.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script&family=Playfair+Display:wght@500&family=Work+Sans&display=swap" rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="~/plantilla/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/plantilla/lib/lightbox/css/lightbox.min.css" rel="stylesheet" />
    <link href="~/plantilla/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />

    <link href="~/plantilla/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/plantilla/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plantilla/css/gatonegro.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Estilos", required: false)
</head>
@* La clase se quita apenas carga: da la entrada suave de la vista. *@
<body class="pagina-entrando">
    <!-- Spinner -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
    </div>

    <!-- Navbar -->
    <div class="container-fluid bg-light sticky-top p-0">
        <nav class="navbar navbar-expand-lg navbar-light p-0">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand bg-primary py-4 px-5 me-0">
                <h1 class="mb-0 d-flex align-items-center">
                    <img src="~/img/gato-negro.png" alt="" class="logo-gato me-2" />@sitio.NombreSitio
                </h1>
            </a>
            <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse p-3" id="navbarCollapse">
                <div class="navbar-nav mx-auto">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-item nav-link @(controlador == "Home" && accion == "Index" ? "active" : null)">Trabajos</a>
                    <a asp-controller="Home" asp-action="Contacto"
                       class="nav-item nav-link @(controlador == "Home" && accion == "Contacto" ? "active" : null)">Contacto</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Admin" asp-action="Index"
                           class="nav-item nav-link @(controlador == "Admin" ? "active" : null)">Panel</a>
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="Login"
                           class="nav-item nav-link @(controlador == "Cuenta" ? "active" : null)">Acceso</a>
                    }
                </div>
                <div class="d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0 me-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary text-uppercase">Cerrar sesión</button>
                        </form>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Facebook))
                    {
                        <a class="btn btn-primary btn-sm-square me-3" href="@sitio.Facebook"
                           target="_blank" rel="noopener" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Instagram))
                    {
                        <a class="btn btn-primary btn-sm-square me-3" href="@sitio.Instagram"
                           target="_blank" rel="noopener" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.TikTok))
                    {
                        <a class="btn btn-primary btn-sm-square me-3" href="@sitio.TikTok"
                           target="_blank" rel="noopener" aria-label="TikTok">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>
                    }
                    @if (sitio.TieneWhatsApp)
                    {
                        <a class="btn btn-primary btn-sm-square" href="@sitio.LinkWhatsApp"
                           target="_blank" rel="noopener" aria-label="WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                    }
                </div>
            </div>
        </nav>
    </div>

    @* Los avisos viajan en atributos y los muestra SweetAlert al cargar la página. *@
    @if (TempData["Exito"] is string exito)
    {
        <div id="avisoExito" data-mensaje="@exito" hidden></div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div id="avisoError" data-mensaje="@errorMsg" hidden></div>
    }

    <main id="contenido">
        @RenderBody()
    </main>

    <!-- Footer -->
    <div class="container-fluid footer position-relative bg-dark text-white-50 py-5 mt-5 wow fadeIn" data-wow-delay="0.2s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-6 pe-lg-5">
                    <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                        <h1 class="display-5 text-primary mb-0 d-flex align-items-center">
                            <img src="~/img/gato-negro.png" alt="" class="logo-gato logo-gato-pie me-2" />@sitio.NombreSitio
                        </h1>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(sitio.TextoBienvenida))
                    {
                        <p>@sitio.TextoBienvenida</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Direccion))
                    {
                        <p class="mb-2"><i class="fa-solid fa-location-dot me-2"></i>@sitio.Direccion</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Telefono))
                    {
                        <p class="mb-2"><i class="fa-solid fa-phone me-2"></i>@sitio.Telefono</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Email))
                    {
                        <p class="mb-2"><i class="fa-solid fa-envelope me-2"></i>@sitio.Email</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Horarios))
                    {
                        <p class="mb-2"><i class="fa-regular fa-clock me-2"></i>@sitio.Horarios</p>
                    }
                    <div class="d-flex justify-content-start mt-4">
                        @if (!string.IsNullOrWhiteSpace(sitio.Facebook))
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.Facebook"
                               target="_blank" rel="noopener" aria-label="Facebook">
                                <i class="fa-brands fa-facebook-f"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(sitio.Instagram))
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.Instagram"
                               target="_blank" rel="noopener" aria-label="Instagram">
                                <i class="fa-brands fa-instagram"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(sitio.TikTok))
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.TikTok"
                               target="_blank" rel="noopener" aria-label="TikTok">
                                <i class="fa-brands fa-tiktok"></i>
                            </a>
                        }
                        @if (sitio.TieneWhatsApp)
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.LinkWhatsApp"
                               target="_blank" rel="noopener" aria-label="WhatsApp">
                                <i class="fa-brands fa-whatsapp"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-6 ps-lg-5">
                    <h5 class="text-primary mb-4">Navegación</h5>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Index">Trabajos</a>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                    @if (sitio.TieneWhatsApp)
                    {
                        <a class="btn btn-link" href="@sitio.LinkWhatsApp" target="_blank" rel="noopener">WhatsApp</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Copyright -->
    <div class="container-fluid bg-dark text-white border-top border-secondary py-4 wow fadeIn" data-wow-delay="0.1s">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; @DateTime.Now.Year @sitio.NombreSitio
                </div>
                <div class="col-md-6 text-center text-md-end">
                    Designed By <a class="border-bottom" href="#">Carlos M. Espíndola</a>.
                </div>
            </div>
        </div>
    </div>

    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top" data-sin-transicion><i class="bi bi-arrow-up"></i></a>

    @if (sitio.TieneWhatsApp)
    {
        <a href="@sitio.LinkWhatsApp" target="_blank" rel="noopener"
           class="wa-flotante" aria-label="Escribinos por WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
        </a>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/plantilla/lib/wow/wow.min.js"></script>
    <script src="~/plantilla/lib/easing/easing.min.js"></script>
    <script src="~/plantilla/lib/waypoints/waypoints.min.js"></script>
    <script src="~/plantilla/lib/counterup/counterup.min.js"></script>
    <script src="~/plantilla/lib/lightbox/js/lightbox.min.js"></script>
    <script src="~/plantilla/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/plantilla/js/main.js"></script>

    <script>
            (function() {
                // Avisos con SweetAlert, en lugar de las cajas del navegador.
                var Aviso = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 4500,
                    timerProgressBar: true,
                    didOpen: function(t) {
                        t.addEventListener('mouseenter', Swal.stopTimer);
                        t.addEventListener('mouseleave', Swal.resumeTimer);
                    }
                });

                var ok = document.getElementById('avisoExito');
                if (ok) Aviso.fire({ icon: 'success', title: ok.dataset.mensaje });

                var mal = document.getElementById('avisoError');
                if (mal) Aviso.fire({ icon: 'error', title: mal.dataset.mensaje });
            })();
    </script>

    <script src="~/js/confirmaciones.js" asp-append-version="true"></script>
    <script src="~/js/transiciones.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
