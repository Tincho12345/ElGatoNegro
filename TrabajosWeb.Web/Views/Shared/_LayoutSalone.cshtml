@using TrabajosWeb.Web.Services
@inject IAjustesService AjustesSrv
@{
    var sitio = await AjustesSrv.ObtenerAsync();
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="es" data-tema="claro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · @sitio.NombreSitio</title>
    <meta name="description" content="@(sitio.TextoBienvenida ?? "Tienda de indumentaria. Camisas, pantalones, abrigos y calzado con las últimas tendencias.")" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" href="~/img/images.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script&family=Playfair+Display:wght@500&family=Work+Sans&display=swap" rel="stylesheet" />

    <!-- Actualizado a FontAwesome 6.5.1 para compatibilidad total con los íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

    <link href="~/plantilla/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/plantilla/lib/lightbox/css/lightbox.min.css" rel="stylesheet" />
    <link href="~/plantilla/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />

    <link href="~/plantilla/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/plantilla/css/style.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/plantilla/css/gatonegro.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/panel-modal.css" rel="stylesheet" asp-append-version="true" />
    <script>
            // Se aplica antes de pintar, para que no haya destello del tema anterior
            (function() {
                try {
                    var guardado = localStorage.getItem('tema');
                    if (guardado) document.documentElement.setAttribute('data-tema', guardado);
                } catch (e) { }
            })();
    </script>

    @await RenderSectionAsync("Estilos", required: false)
</head>
<body class="pagina-entrando">
    <!-- Spinner -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
    </div>

    <!-- Navbar -->
    <div class="container-fluid bg-light sticky-top p-0">
        <nav class="navbar navbar-expand-lg navbar-light p-0">
            <a asp-controller="Home" asp-action="Index" class="navbar-brand bg-primary py-4 px-5 me-0">
                <h1 class="mb-0 d-flex align-items-center">
                    <img src="~/img/images.png" alt="" class="logo-gato me-2" />@sitio.NombreSitio
                </h1>
            </a>
            <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse p-3" id="navbarCollapse">
                <div class="navbar-nav mx-auto align-items-lg-center">
                    <!-- Submenú Productos Dinámico -->
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle @(controlador == "Home" && accion == "Index" ? "active" : null)" data-bs-toggle="dropdown" aria-expanded="false">Artículos</a>
                        <div class="dropdown-menu m-0 bg-light border-0 shadow-sm">
                            <a asp-controller="Home" asp-action="Index" class="dropdown-item">Todos los Artículos</a>

                            @if (ViewData.Model is TrabajosWeb.Web.Models.GaleriaViewModel galeriaModel && galeriaModel.Categorias != null)
                            {
                                @foreach (var cat in galeriaModel.Categorias)
                                {
                                    <a asp-controller="Home" asp-action="Index" asp-route-categoria="@cat.Slug"
                                       class="dropdown-item filtro-externo" data-slug="@cat.Slug">
                                        @if (!string.IsNullOrWhiteSpace(cat.Icono))
                                        {
                                            <i class="@cat.Icono me-2"></i>
                                        }
                                        @cat.Nombre
                                    </a>
                                }
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" asp-route-categoria="productos"
                                   class="dropdown-item filtro-externo" data-slug="productos">Artículos</a>
                            }
                        </div>
                    </div>
                    <a asp-controller="Home" asp-action="Contacto"
                       class="nav-item nav-link @(controlador == "Home" && accion == "Contacto" ? "active" : null)">Contacto</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Admin" asp-action="Index"
                           class="nav-item nav-link @(controlador == "Admin" ? "active" : null)">Panel</a>
                    }
                    else
                    {
                        <a asp-controller="Cuenta" asp-action="Login"
                           class="nav-item nav-link @(controlador == "Cuenta" ? "active" : null)">Acceso</a>
                    }

                    <!-- Selector de Temas -->
                    <div class="nav-item ms-lg-3 my-2 my-lg-0 d-flex align-items-center">
                        <div class="temas" role="group" aria-label="Elegir estilo visual">
                            <button type="button" class="tema-opcion tema-claro" data-tema-valor="claro"
                                    aria-pressed="true" title="Claro"></button>
                            <button type="button" class="tema-opcion tema-oscuro" data-tema-valor="oscuro"
                                    aria-pressed="false" title="Oscuro"></button>
                            <button type="button" class="tema-opcion tema-bloques" data-tema-valor="bloques"
                                    aria-pressed="false" title="Bloques de color"></button>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @* En cualquier vista mientras el admin esté logueado,
                       no solo dentro del panel: un visitante del sitio no
                       tiene nada que suscribir. El color se lo cambia
                       push.js según haya o no una suscripción activa
                       en este navegador. *@
                        <button type="button"
                                class="boton-notificaciones btn btn-sm btn-outline-primary btn-sm-square me-3 position-relative"
                                aria-pressed="false" title="Activar notificaciones de consultas nuevas">
                            <i class="fa-solid fa-bell"></i>
                        </button>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Cuenta" asp-action="Logout" method="post" class="m-0 me-3">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-primary text-uppercase">Cerrar sesión</button>
                        </form>
                    }
                    <!-- Botón del carrito en el navbar -->
                    <a href="#" id="abrirModalCarrito" class="btn btn-primary btn-sm-square position-relative me-3" title="Ver Carrito">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span id="contadorCarrito" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; display: none;">
                            0
                        </span>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(sitio.Facebook))
                    {
                        <a class="btn btn-primary btn-sm-square me-3" href="@sitio.Facebook"
                           target="_blank" rel="noopener" aria-label="Facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Instagram))
                    {
                        <a class="btn btn-primary btn-sm-square me-3" href="@sitio.Instagram"
                           target="_blank" rel="noopener" aria-label="Instagram">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.TikTok))
                    {
                        <a class="btn btn-primary btn-sm-square me-3" href="@sitio.TikTok"
                           target="_blank" rel="noopener" aria-label="TikTok">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>
                    }
                    @if (sitio.TieneWhatsApp)
                    {
                        <a class="btn btn-primary btn-sm-square" href="@sitio.LinkWhatsApp"
                           target="_blank" rel="noopener" aria-label="WhatsApp">
                            <i class="fa-brands fa-whatsapp"></i>
                        </a>
                    }
                </div>
            </div>
        </nav>
    </div>

    <!-- Modal del carrito de compras -->
    <div class="modal fade" id="modalCarrito" tabindex="-1" aria-labelledby="modalCarritoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title font-dancing-script text-primary fs-2" id="modalCarritoLabel">Tu Carrito de Compras</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div id="carritoContenidoVacio" class="text-center py-5">
                        <i class="fa-solid fa-cart-shopping fa-3x text-muted mb-3"></i>
                        <p class="fs-5 text-muted">Tu carrito está vacío.</p>
                    </div>

                    <div id="carritoContenidoLleno" class="table-responsive" style="display: none;">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th>Cant.</th>
                                    <th>Subtotal</th>
                                    <th><i class="fa-solid fa-trash-can"></i></th>
                                </tr>
                            </thead>
                            <tbody id="tablaCarritoCuerpo">
                                <!-- Los items se cargan dinámicamente con JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer flex-column align-items-stretch bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-3" id="contenedorTotal" style="display: none;">
                        <span class="fs-5 fw-bold">Total a Pagar:</span>
                        <span id="carritoTotalMonto" class="fs-4 fw-bold text-primary">$0</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger w-50" id="btnVaciarCarrito">
                            <i class="fa-solid fa-trash me-2"></i>Vaciar Carrito
                        </button>
                        <button type="button" class="btn btn-success w-50 text-uppercase" id="btnFinalizarPedido">
                            <i class="fa-solid fa-check me-2"></i>Confirmar Pedido
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Avisos manejados por SweetAlert *@
    @if (TempData["Exito"] is string exito)
    {
        <div id="avisoExito" data-mensaje="@exito" hidden></div>
    }
    @if (TempData["Error"] is string errorMsg)
    {
        <div id="avisoError" data-mensaje="@errorMsg" hidden></div>
    }

    <main id="contenido">
        @RenderBody()
    </main>

    <!-- Footer -->
    <div class="container-fluid footer position-relative bg-dark text-white-50 py-5 mt-5 wow fadeIn" data-wow-delay="0.2s">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-6 pe-lg-5">
                    <a asp-controller="Home" asp-action="Index" class="navbar-brand">
                        <h1 class="display-5 text-primary mb-0 d-flex align-items-center">
                            <img src="~/img/images.png" alt="" class="logo-gato logo-gato-pie me-2" />@sitio.NombreSitio
                        </h1>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(sitio.TextoBienvenida))
                    {
                        <p>@sitio.TextoBienvenida</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Direccion))
                    {
                        <p class="mb-2"><i class="fa-solid fa-location-dot me-2"></i>@sitio.Direccion</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Telefono))
                    {
                        <p class="mb-2"><i class="fa-solid fa-phone me-2"></i>@sitio.Telefono</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Email))
                    {
                        <p class="mb-2"><i class="fa-solid fa-envelope me-2"></i>@sitio.Email</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(sitio.Horarios))
                    {
                        <p class="mb-2"><i class="fa-regular fa-clock me-2"></i>@sitio.Horarios</p>
                    }
                    <div class="d-flex justify-content-start mt-4">
                        @if (!string.IsNullOrWhiteSpace(sitio.Facebook))
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.Facebook"
                               target="_blank" rel="noopener" aria-label="Facebook">
                                <i class="fa-brands fa-facebook-f"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(sitio.Instagram))
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.Instagram"
                               target="_blank" rel="noopener" aria-label="Instagram">
                                <i class="fa-brands fa-instagram"></i>
                            </a>
                        }
                        @if (!string.IsNullOrWhiteSpace(sitio.TikTok))
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.TikTok"
                               target="_blank" rel="noopener" aria-label="TikTok">
                                <i class="fa-brands fa-tiktok"></i>
                            </a>
                        }
                        @if (sitio.TieneWhatsApp)
                        {
                            <a class="btn btn-sm-square btn-primary me-3" href="@sitio.LinkWhatsApp"
                               target="_blank" rel="noopener" aria-label="WhatsApp">
                                <i class="fa-brands fa-whatsapp"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-6 ps-lg-5">
                    <h5 class="text-primary mb-4">Navegación</h5>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Index">Artículos</a>
                    <a class="btn btn-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                    @if (sitio.TieneWhatsApp)
                    {
                        <a class="btn btn-link" href="@sitio.LinkWhatsApp" target="_blank" rel="noopener">WhatsApp</a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Copyright -->
    <div class="container-fluid bg-dark text-white border-top border-secondary py-4 wow fadeIn" data-wow-delay="0.1s">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; @DateTime.Now.Year @sitio.NombreSitio
                </div>
                <div class="col-md-6 text-center text-md-end">
                    Designed By <a class="border-bottom" href="#">Carlos M. Espíndola</a>.
                </div>
            </div>
        </div>
    </div>

    <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top" data-sin-transicion><i class="bi bi-arrow-up"></i></a>

    @if (sitio.TieneWhatsApp)
    {
        <a href="@sitio.LinkWhatsApp" target="_blank" rel="noopener"
           class="wa-flotante" aria-label="Escribinos por WhatsApp">
            <i class="fa-brands fa-whatsapp"></i>
        </a>
    }

    <!-- Barra de Navegación Inferior para Mobile (Estilo App / Mercado Libre) -->
    <nav class="mobile-bottom-nav d-lg-none">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item @(controlador == "Home" && accion == "Index" ? "active" : null)">
            <i class="fa-solid fa-house"></i>
            <span>Inicio</span>
        </a>
        <a href="#" class="mobile-nav-item" data-bs-toggle="collapse" data-bs-target="#navbarCollapse" aria-expanded="false">
            <i class="fa-solid fa-list"></i>
            <span>Menú</span>
        </a>
        <!-- Botón de carrito inferior, mismo id para sincronizar el contador -->
        <a href="#" id="abrirModalCarritoMobile" class="mobile-nav-item position-relative" title="Ver Carrito">
            <i class="fa-solid fa-cart-shopping"></i>
            <span id="contadorCarritoMobile" class="position-absolute top-25 start-50 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; display: none;">
                0
            </span>
            <span>Carrito</span>
        </a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Admin" asp-action="Index" class="mobile-nav-item @(controlador == "Admin" ? "active" : null)">
                <i class="fa-solid fa-gauge-high"></i>
                <span>Panel</span>
            </a>
            @* Acceso directo a Consultas, con contador de no leídas, en
               cualquier vista mientras el admin esté logueado (no solo
               dentro del panel). NO activa ni desactiva notificaciones:
               eso se hace solo desde la campanita del menú hamburguesa,
               arriba. *@
            @* Va al panel (Index) y no directo a Consultas: el número del badge
               ahora suma consultas + pedidos sin leer, así que puede haber
               avisos ahí aunque no haya ninguna consulta nueva. Desde el
               panel el admin ve los dos contadores por separado y elige. *@
            <a asp-controller="Admin" asp-action="Index" class="mobile-nav-item position-relative">
                <i class="fa-solid fa-bell"></i>
                <span>Avisos</span>
                <span class="badge-notificaciones badge rounded-pill bg-danger position-absolute"
                      style="display:none; top:2px; right:20%; font-size:.6rem;">0</span>
            </a>
        }
        else
        {
            <a asp-controller="Cuenta" asp-action="Login" class="mobile-nav-item @(controlador == "Cuenta" ? "active" : null)">
                <i class="fa-solid fa-user"></i>
                <span>Acceso</span>
            </a>
        }
    </nav>

    <!-- Scripts Esenciales -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>
    <script src="~/plantilla/lib/wow/wow.min.js"></script>
    <script src="~/plantilla/lib/easing/easing.min.js"></script>
    <script src="~/plantilla/lib/waypoints/waypoints.min.js"></script>
    <script src="~/plantilla/lib/counterup/counterup.min.js"></script>
    <script src="~/plantilla/lib/lightbox/js/lightbox.min.js"></script>
    <script src="~/plantilla/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/plantilla/js/main.js"></script>

    <script>
            (function() {
                var Aviso = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 4500,
                    timerProgressBar: true,
                    didOpen: function(t) {
                        t.addEventListener('mouseenter', Swal.stopTimer);
                        t.addEventListener('mouseleave', Swal.resumeTimer);
                    }
                });

                var ok = document.getElementById('avisoExito');
                if (ok) Aviso.fire({ icon: 'success', title: ok.dataset.mensaje });

                var mal = document.getElementById('avisoError');
                if (mal) Aviso.fire({ icon: 'error', title: mal.dataset.mensaje });
            })();
    </script>

    <script src="~/js/temas.js" asp-append-version="true"></script>

    @* Esconde la barra inferior al bajar por la página *@
    <script src="~/js/barra-mobile.js" asp-append-version="true"></script>
    <script src="~/js/confirmaciones.js" asp-append-version="true"></script>
    <script src="~/js/transiciones.js" asp-append-version="true"></script>
    <script src="~/js/trabajo-modal.js" asp-append-version="true"></script>
    <script src="~/js/panel-tabla.js" asp-append-version="true"></script>
    <!-- Carrito: maneja el modal, el contador y la confirmación del pedido -->
    <script src="~/js/carrito.js" asp-append-version="true"></script>
    <script src="~/js/push.js" asp-append-version="true"></script>

    @* Cierre por inactividad. Solo con sesión iniciada: en el login no hay
       nada que caducar. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/sesion-inactividad.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
