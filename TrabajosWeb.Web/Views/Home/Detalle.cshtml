@using TrabajosWeb.Shared.DTOs
@model TrabajosWeb.Web.Models.GaleriaViewModel
@{
    var trabajo = Model.Trabajos.First();
    ViewData["Title"] = trabajo.Titulo;
    Layout = "_LayoutSalone";

    ViewData["VolverUrl"] = Url.Action("Index", "Home");
    ViewData["VolverTexto"] = "Volver a los trabajos";

    var medios = trabajo.Medios.OrderBy(m => m.Orden).ToList();
    var fotos = medios.Count(m => m.Tipo == TipoMedia.Imagen);
    var videos = medios.Count(m => m.Tipo == TipoMedia.Video);
    var grupo = $"trabajo-{trabajo.Id}";
    var etiqueta = trabajo.EtiquetaCalculada;

    // Dirección de esta misma página, para que la consulta llegue con el link.
    var enlaceTrabajo = Url.Action("Detalle", "Home",
        new { id = trabajo.Id }, Context.Request.Scheme);

    // Mensaje de WhatsApp armado con los datos del trabajo. Los saltos de
    // línea viajan como %0A y WhatsApp los respeta.
    var lineas = new List<string>
    {
        Model.Contacto.MensajePredeterminado,
        string.Empty,
        $"Me interesa: {trabajo.Titulo}"
    };

    if (!string.IsNullOrWhiteSpace(trabajo.MarcaNombre))
    {
        lineas.Add($"Marca: {trabajo.MarcaNombre}");
    }

    if (trabajo.Precio.HasValue)
    {
        lineas.Add($"Precio publicado: {trabajo.Precio.Value.ToString("C0")}");
    }

    if (!string.IsNullOrWhiteSpace(enlaceTrabajo))
    {
        lineas.Add(enlaceTrabajo);
    }

    var mensaje = string.Join("\n", lineas);
    var linkConsulta = $"https://wa.me/{Model.Contacto.WhatsAppNumero}?text={Uri.EscapeDataString(mensaje)}";

    var primero = medios.FirstOrDefault();
}

<div class="container-fluid bg-light page-header py-5 mb-5">
    <div class="container text-center py-5">
        <h1 class="font-dancing-script text-primary animated slideInLeft">@trabajo.CategoriaNombre</h1>
        <h1 class="display-2 animated slideInLeft">@trabajo.Titulo</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center animated slideInLeft mb-0">
                <li class="breadcrumb-item">
                    <a class="text-primary" asp-action="Index">Trabajos</a>
                </li>
                <li class="breadcrumb-item">
                    <a class="text-primary" asp-action="Index" asp-route-categoria="@trabajo.CategoriaSlug">@trabajo.CategoriaNombre</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">@trabajo.Titulo</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-fluid gallery py-5">
    <div class="container">
        <div class="mb-4 wow fadeIn" data-wow-delay="0.1s">
            <partial name="_Volver" />
        </div>

        <div class="row g-5">
            <div class="col-lg-8">
                @if (!string.IsNullOrWhiteSpace(trabajo.Descripcion))
                {
                    <p class="fs-5 mb-4 wow fadeIn" data-wow-delay="0.1s">@trabajo.Descripcion</p>
                }

                <div class="ficha wow fadeIn" data-wow-delay="0.2s">
                    <div class="ficha-dato">
                        <i class="fa-solid fa-tag"></i>
                        <span>@trabajo.CategoriaNombre</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(trabajo.MarcaNombre))
                    {
                        <div class="ficha-dato">
                            <i class="fa-solid fa-award"></i>
                            <span>@trabajo.MarcaNombre</span>
                        </div>
                    }
                    @if (fotos > 0)
                    {
                        <div class="ficha-dato">
                            <i class="fa-regular fa-images"></i>
                            <span>@fotos @(fotos == 1 ? "foto" : "fotos")</span>
                        </div>
                    }
                    @if (videos > 0)
                    {
                        <div class="ficha-dato">
                            <i class="fa-solid fa-play"></i>
                            <span>@videos @(videos == 1 ? "video" : "videos")</span>
                        </div>
                    }
                    @if (trabajo.Destacado)
                    {
                        <div class="ficha-dato destacado">
                            <i class="fa-solid fa-star"></i>
                            <span>Destacado</span>
                        </div>
                    }
                </div>

                @if (!medios.Any())
                {
                    <div class="galeria-vacia wow fadeIn" data-wow-delay="0.2s">
                        <i class="fa-regular fa-images d-block"></i>
                        <p class="fs-5 mb-0">Este trabajo todavía no tiene fotos ni videos.</p>
                    </div>
                }
                else
                {
                    <div class="visor @(medios.Count > 1 ? null : "visor-solo") wow fadeIn" data-wow-delay="0.2s">
                        @if (medios.Count > 1)
                        {
                            <div class="visor-miniaturas" role="tablist" aria-label="Fotos y videos">
                                @for (var i = 0; i < medios.Count; i++)
                                {
                                    var media = medios[i];
                                    var url = Model.ApiBaseUrl + media.Url;

                                    <button type="button"
                                            class="visor-mini @(i == 0 ? "activa" : null)"
                                            role="tab" aria-selected="@(i == 0 ? "true" : "false")"
                                            data-indice="@i"
                                            data-url="@url"
                                            data-tipo="@(media.Tipo == TipoMedia.Imagen ? "imagen" : "video")"
                                            data-alt="@(media.TextoAlternativo ?? trabajo.Titulo)">
                                        @if (media.Tipo == TipoMedia.Imagen)
                                        {
                                            <img src="@url" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <video src="@url" preload="metadata" muted></video>
                                            <span class="visor-mini-play"><i class="fa-solid fa-play"></i></span>
                                        }
                                    </button>
                                }
                            </div>
                        }

                        <div class="visor-principal">
                            @if (primero is not null && primero.Tipo == TipoMedia.Imagen)
                            {
                                <img id="visorImagen" src="@(Model.ApiBaseUrl + primero.Url)"
                                     alt="@(primero.TextoAlternativo ?? trabajo.Titulo)" />
                            }
                            else
                            {
                                <img id="visorImagen" src="" alt="@trabajo.Titulo" hidden />
                            }

                            <video id="visorVideo" controls preload="metadata" playsinline
                                   @(primero is not null && primero.Tipo == TipoMedia.Video ? "" : "hidden")>
                                @if (primero is not null && primero.Tipo == TipoMedia.Video)
                                {
                                    <source src="@(Model.ApiBaseUrl + primero.Url)" />
                                }
                                Tu navegador no puede reproducir este video.
                            </video>

                            @if (fotos > 0)
                            {
                                <button type="button" class="visor-expandir" id="visorExpandir"
                                        aria-label="Ver en grande">
                                    <i class="fa-solid fa-expand"></i>
                                </button>
                            }
                        </div>
                    </div>

                    @* Anclas ocultas: le dan a la lupa el álbum completo con
                       flechas de anterior y siguiente. *@
                    <div class="d-none">
                        @foreach (var media in medios.Where(m => m.Tipo == TipoMedia.Imagen))
                        {
                            <a href="@(Model.ApiBaseUrl + media.Url)"
                               data-lightbox="@grupo"
                               data-title="@trabajo.Titulo"
                               data-sin-transicion
                               data-url="@(Model.ApiBaseUrl + media.Url)"></a>
                        }
                    </div>
                }

                <div class="mt-5">
                    <partial name="_Volver" />
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-light p-5 panel-consulta wow fadeIn" data-wow-delay="0.3s">
                    @if (!string.IsNullOrWhiteSpace(etiqueta))
                    {
                        <span class="marca-oferta d-inline-block mb-3">@etiqueta</span>
                    }

                    @if (trabajo.Precio.HasValue)
                    {
                        <div class="precio-panel">
                            @if (trabajo.PrecioAnterior > trabajo.Precio)
                            {
                                <span class="precio-panel-anterior">@trabajo.PrecioAnterior!.Value.ToString("C0")</span>
                            }
                            <span class="precio-panel-actual">@trabajo.Precio.Value.ToString("C0")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(trabajo.TextoOferta))
                        {
                            <p class="precio-panel-nota">@trabajo.TextoOferta</p>
                        }

                        <hr class="my-4" style="opacity:.15;" />
                    }
                    else if (!string.IsNullOrWhiteSpace(trabajo.TextoOferta))
                    {
                        <p class="precio-panel-nota">@trabajo.TextoOferta</p>
                        <hr class="my-4" style="opacity:.15;" />
                    }

                    <h1 class="font-dancing-script text-primary">Consultanos</h1>
                    <h3 class="mb-4">¿Querés algo así?</h3>
                    <p class="mb-4">
                        Contanos qué tenés en mente y te pasamos precio y disponibilidad.
                    </p>

                    <a href="@linkConsulta" target="_blank" rel="noopener"
                       class="btn btn-primary text-uppercase w-100 py-3 mb-3 mx-0">
                        <i class="fa-brands fa-whatsapp me-2"></i>Consultar por WhatsApp
                    </a>

                    <a asp-action="Contacto" asp-route-trabajo="@trabajo.Id"
                       class="btn btn-dark text-uppercase w-100 py-3 mx-0">
                        <i class="fa-solid fa-envelope me-2"></i>Enviar un mensaje
                    </a>
                </div>
            </div>
        </div>

        @if (Model.Relacionados.Any())
        {
            <div class="mt-5 pt-5">
                <div class="text-center wow fadeIn" data-wow-delay="0.1s">
                    <h1 class="font-dancing-script text-primary">También te puede gustar</h1>
                    <h1 class="mb-5">Más de @trabajo.CategoriaNombre</h1>
                </div>

                <div class="row g-0">
                    @foreach (var otro in Model.Relacionados)
                    {
                        var portadaOtro = otro.Medios
                            .OrderBy(m => m.Orden)
                            .FirstOrDefault(m => m.Tipo == TipoMedia.Imagen);

                        <div class="col-md-4 wow fadeIn" data-wow-delay="0.2s">
                            <a asp-action="Detalle" asp-route-id="@otro.Id" class="gallery-item d-block">
                                @if (portadaOtro is not null)
                                {
                                    <img src="@(Model.ApiBaseUrl + portadaOtro.Url)"
                                         alt="@otro.Titulo" loading="lazy" />
                                }
                                else
                                {
                                    <div class="pieza-vacia"><i class="fa-solid fa-scissors"></i></div>
                                }

                                <div class="gallery-icon">
                                    <span class="btn btn-primary btn-lg-square"><i class="fa-solid fa-eye"></i></span>
                                </div>

                                <div class="pieza-pie">
                                    <h3 class="pieza-titulo">@otro.Titulo</h3>
                                    @if (otro.Precio.HasValue)
                                    {
                                        <div class="pieza-precio">
                                            <span class="precio-actual">@otro.Precio.Value.ToString("C0")</span>
                                        </div>
                                    }
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* ---------- Visor: foto grande con miniaturas al costado ---------- */
    .visor {
        display: flex;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .visor-miniaturas {
        display: flex;
        flex-direction: column;
        gap: .6rem;
        flex: 0 0 5.5rem;
        max-height: 32rem;
        overflow-y: auto;
        padding-right: .25rem;
    }

    .visor-mini {
        position: relative;
        width: 5.5rem;
        height: 5.5rem;
        padding: 0;
        overflow: hidden;
        background: none;
        border: 2px solid transparent;
        border-radius: .4rem;
        cursor: pointer;
        opacity: .6;
        transition: opacity .2s ease, border-color .2s ease;
    }

        .visor-mini:hover {
            opacity: 1;
        }

        .visor-mini.activa {
            opacity: 1;
            border-color: var(--bs-primary);
        }

        .visor-mini img,
        .visor-mini video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .visor-mini-play {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, .35);
        color: #fff;
        font-size: .9rem;
    }

    .visor-principal {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
        height: 32rem;
        overflow: hidden;
        border-radius: .5rem;
        background-color: rgba(0, 0, 0, .04);
    }

        .visor-principal img,
        .visor-principal video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        /* La lupa del cursor avisa que la foto se amplía */
        .visor-principal img {
            cursor: zoom-in;
        }

    .visor-expandir {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        width: 2.8rem;
        height: 2.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: var(--bs-primary);
        color: #fff;
        border: 0;
        border-radius: .4rem;
        opacity: .85;
        cursor: pointer;
        transition: opacity .2s ease, transform .2s ease;
    }

        .visor-expandir:hover {
            opacity: 1;
            transform: scale(1.06);
        }

    /* Con un solo archivo no hay tira de miniaturas, así que el visor se
       adapta a la imagen: sin alto fijo no quedan franjas a los costados. */
    .visor-solo .visor-principal {
        height: auto;
        background-color: transparent;
        text-align: center;
    }

        .visor-solo .visor-principal img,
        .visor-solo .visor-principal video {
            width: auto;
            height: auto;
            max-width: 100%;
            max-height: 32rem;
            margin-inline: auto;
        }

    /* En pantallas chicas las miniaturas pasan abajo, en una tira horizontal */
    @@media (max-width: 767.98px) {
        .visor {
            flex-direction: column-reverse;
        }

        .visor-miniaturas {
            flex-direction: row;
            flex: 0 0 auto;
            max-height: none;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: .25rem;
        }

        .visor-mini {
            flex: 0 0 4.5rem;
            width: 4.5rem;
            height: 4.5rem;
        }

        .visor-principal {
            height: 20rem;
        }

        .visor-solo .visor-principal {
            height: auto;
        }

            .visor-solo .visor-principal img,
            .visor-solo .visor-principal video {
                max-height: 20rem;
            }
    }

    html[data-tema="oscuro"] .visor-principal {
        background-color: rgba(255, 255, 255, .05);
    }
</style>

@section Scripts {
    <script>
        (function () {
            var principal = document.querySelector('.visor-principal');
            if (!principal) return;

            var imagen = document.getElementById('visorImagen');
            var video = document.getElementById('visorVideo');
            var expandir = document.getElementById('visorExpandir');
            var minis = document.querySelectorAll('.visor-mini');

            // Las anclas ocultas son las que abren la lupa con el álbum entero.
            var anclas = document.querySelectorAll('a[data-lightbox][data-url]');
            var urlActual = imagen && !imagen.hidden ? imagen.getAttribute('src') : '';

            function mostrar(mini) {
                var url = mini.dataset.url;
                var esImagen = mini.dataset.tipo === 'imagen';

                minis.forEach(function (otra) {
                    otra.classList.toggle('activa', otra === mini);
                    otra.setAttribute('aria-selected', otra === mini);
                });

                // El video anterior sigue sonando si no se lo frena a mano.
                video.pause();

                if (esImagen) {
                    imagen.src = url;
                    imagen.alt = mini.dataset.alt || '';
                    imagen.hidden = false;
                    video.hidden = true;
                    urlActual = url;
                    if (expandir) expandir.hidden = false;
                } else {
                    video.src = url;
                    video.hidden = false;
                    imagen.hidden = true;
                    if (expandir) expandir.hidden = true;
                }
            }

            minis.forEach(function (mini) {
                mini.addEventListener('click', function () { mostrar(mini); });
            });

            // Abre la lupa en la foto que se está viendo. El álbum lo arman
            // las anclas ocultas, así que adentro quedan las flechas para
            // recorrer todas las fotos del trabajo.
            function abrirLupa() {
                for (var i = 0; i < anclas.length; i++) {
                    if (anclas[i].dataset.url === urlActual) {
                        anclas[i].click();
                        return;
                    }
                }

                if (anclas.length) anclas[0].click();
            }

            if (expandir) {
                expandir.addEventListener('click', abrirLupa);
            }

            // La foto grande también abre: es lo que uno intenta primero.
            if (imagen) {
                imagen.addEventListener('click', function () {
                    if (!imagen.hidden) abrirLupa();
                });
            }
        })();
    </script>
}
