@using TrabajosWeb.Shared.DTOs
@model TrabajosWeb.Web.Models.GaleriaViewModel
@{
    ViewData["Title"] = "Trabajos";
    Layout = "_LayoutSalone";

    // Patrón de Salone: 6-3-3 / 3-3-6, repetido cada seis piezas.
    var anchos = new[] { "col-md-6", "col-md-3", "col-md-3", "col-md-3", "col-md-3", "col-md-6" };
    var demoras = new[] { "0.2s", "0.4s", "0.6s" };

    // El carrusel del hero usa los destacados; si no hay, los primeros trabajos.
    var destacados = Model.Trabajos.Where(t => t.Destacado).ToList();
    if (!destacados.Any())
        destacados = Model.Trabajos.Take(3).ToList();

    var portadasHero = destacados
        .Select(t => t.Medios.OrderBy(m => m.Orden).FirstOrDefault(m => m.Tipo == TipoMedia.Imagen))
        .Where(m => m is not null)
        .Take(3)
        .ToList();
}

<!-- Hero -->
<div class="container-fluid p-0 hero-header bg-light mb-5">
    <div class="container p-0">
        <div class="row g-0 align-items-center">
            <div class="@(portadasHero.Any() ? "col-lg-6" : "col-12") hero-header-text py-5">
                <div class="py-5 px-3 ps-lg-0">
                    <h1 class="font-dancing-script text-primary animated slideInLeft">Bienvenida</h1>
                    <h1 class="display-1 mb-4 animated slideInLeft">El Gato Negro</h1>
                    <p class="fs-5 mb-4 animated slideInLeft">
                        Cortes, color, brushing y tratamientos. Mirá lo que hicimos y contanos qué tenés en mente.
                    </p>
                    <div class="row g-4 animated slideInLeft">
                        <div class="col-md-6">
                            <a href="@Model.Contacto.LinkWhatsApp" target="_blank" rel="noopener"
                               class="d-flex align-items-center text-decoration-none">
                                <div class="btn-square btn btn-primary flex-shrink-0">
                                    <i class="fa-brands fa-whatsapp text-dark"></i>
                                </div>
                                <div class="px-3">
                                    <h5 class="text-primary mb-0">Escribinos</h5>
                                    <p class="fs-5 text-dark mb-0">WhatsApp</p>
                                </div>
                            </a>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Contacto.Email))
                        {
                            <div class="col-md-6">
                                <a href="mailto:@Model.Contacto.Email" class="d-flex align-items-center text-decoration-none">
                                    <div class="btn-square btn btn-primary flex-shrink-0">
                                        <i class="fa-solid fa-envelope text-dark"></i>
                                    </div>
                                    <div class="px-3">
                                        <h5 class="text-primary mb-0">Correo</h5>
                                        <p class="fs-6 text-dark mb-0">@Model.Contacto.Email</p>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
            @if (portadasHero.Any())
            {
                <div class="col-lg-6">
                    <div class="owl-carousel header-carousel animated fadeIn">
                        @foreach (var portada in portadasHero)
                        {
                            <img class="img-fluid" src="@(Model.ApiBaseUrl + portada!.Url)"
                                 alt="@portada.TextoAlternativo" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Servicios.Any())
{
    <div class="container-fluid service py-5">
        <div class="container">
            <div class="text-center wow fadeIn" data-wow-delay="0.1s">
                <h1 class="font-dancing-script text-primary">Servicios</h1>
                <h1 class="mb-5">Lo que hacemos</h1>
            </div>
            <div class="row g-0">
                @for (var i = 0; i < Model.Servicios.Count; i++)
                {
                    var servicio = Model.Servicios[i];
                    var texto = string.IsNullOrWhiteSpace(servicio.TextoServicio)
                        ? servicio.Descripcion
                        : servicio.TextoServicio;

                    <div class="col-lg-4 col-md-6 wow fadeIn" data-wow-delay="@demoras[i % 3]">
                        <div class="service-item border h-100 p-5 text-center">
                            @if (!string.IsNullOrWhiteSpace(servicio.Icono))
                            {
                                <i class="@servicio.Icono fa-3x text-primary mb-4"></i>
                            }
                            <h4 class="mb-3">@servicio.Nombre</h4>
                            @if (!string.IsNullOrWhiteSpace(texto))
                            {
                                <p class="mb-4">@texto</p>
                            }
                            <a asp-action="Index" asp-route-categoria="@servicio.Slug"
                               class="btn btn-primary text-uppercase px-4 py-2">
                                Ver trabajos
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="container-fluid gallery py-5">
    <div class="container">
        <div class="text-center wow fadeIn" data-wow-delay="0.1s">
            <h1 class="font-dancing-script text-primary">Galería</h1>
            <h1 class="mb-5">Nuestros trabajos</h1>
        </div>

        @if (Model.Categorias.Any())
        {
            <nav class="filtros wow fadeIn" data-wow-delay="0.2s" aria-label="Filtrar por tipo de trabajo">
                <a asp-action="Index"
                   class="filtro @(string.IsNullOrEmpty(Model.CategoriaActual) ? "activo" : null)">
                    Todo
                </a>
                @foreach (var categoria in Model.Categorias)
                {
                    <a asp-action="Index" asp-route-categoria="@categoria.Slug"
                       class="filtro @(Model.CategoriaActual == categoria.Slug ? "activo" : null)">
                        @if (!string.IsNullOrWhiteSpace(categoria.Icono))
                        {
                            <i class="@categoria.Icono"></i>
                        }
                        @categoria.Nombre
                    </a>
                }
            </nav>
        }

        @if (!Model.Trabajos.Any())
        {
            <div class="galeria-vacia wow fadeIn" data-wow-delay="0.2s">
                <i class="fa-regular fa-images d-block"></i>
                <p class="fs-5">
                    @(string.IsNullOrEmpty(Model.CategoriaActual)
                        ? "Todavía no hay trabajos publicados."
                        : "No hay trabajos en esta categoría por ahora.")
                </p>
                <a href="@Model.Contacto.LinkWhatsApp" target="_blank" rel="noopener"
                   class="btn btn-primary text-uppercase px-5 py-3">
                    <i class="fa-brands fa-whatsapp me-2"></i>Consultanos
                </a>
            </div>
        }
        else
        {
            <div class="row g-0">
                @for (var i = 0; i < Model.Trabajos.Count; i++)
                {
                    var trabajo = Model.Trabajos[i];

                    var portada = trabajo.Medios
                        .OrderBy(m => m.Orden)
                        .FirstOrDefault(m => m.Tipo == TipoMedia.Imagen);

                    var videos = trabajo.Medios.Count(m => m.Tipo == TipoMedia.Video);

                    <div class="@anchos[i % 6] wow fadeIn" data-wow-delay="@demoras[i % 3]">
                        <a asp-action="Detalle" asp-route-id="@trabajo.Id" class="gallery-item d-block">
                            @if (portada is not null)
                            {
                                <img src="@(Model.ApiBaseUrl + portada.Url)"
                                     alt="@(portada.TextoAlternativo ?? trabajo.Titulo)" loading="lazy" />
                            }
                            else
                            {
                                <div class="pieza-vacia"><i class="fa-solid fa-scissors"></i></div>
                            }

                            @if (trabajo.Destacado)
                            {
                                <span class="marca-destacado">Destacado</span>
                            }

                            @if (videos > 0)
                            {
                                <span class="marca-video"><i class="fa-solid fa-play"></i>@videos</span>
                            }

                            <div class="gallery-icon">
                                <span class="btn btn-primary btn-lg-square"><i class="fa-solid fa-eye"></i></span>
                            </div>

                            <div class="pieza-pie">
                                <h3 class="pieza-titulo">@trabajo.Titulo</h3>
                                <span class="pieza-categoria">@trabajo.CategoriaNombre</span>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>